# Dev image for the Django/DRF backend.
# Build context is the `backend/` directory (see docker-compose.yml).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Minimal build tooling; the pinned packages ship manylinux wheels, so this
# stays small but covers any source builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Source is bind-mounted in dev (compose), so this COPY is just a fallback
# for building/running the image standalone.
COPY . .

EXPOSE 8000

# Overridden by compose (which also runs migrations first).
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
